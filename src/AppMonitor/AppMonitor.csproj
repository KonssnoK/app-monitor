<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10/11 install: the result is a single small exe, no runtime needed. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AppMonitor</AssemblyName>
    <RootNamespace>AppMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>AppMonitor</Product>
    <Description>Lightweight portable resource recorder</Description>
    <!-- Default for local builds. Release builds pass -p:Version=X.Y.Z taken from the git tag vX.Y.Z (see .github/workflows/release.yml). -->
    <Version>1.0.0</Version>
    <Company>KonssnoK</Company>
    <Copyright>Copyright (c) 2026 KonssnoK. MIT License.</Copyright>
    <!-- Version shown in the app: plain "1.0.0", without the "+commit" suffix the SDK would append. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- No .exe.config next to the exe: keep it a single portable file. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fan RPM / real temperatures. GPU works as normal user; motherboard + CPU need admin and the PawnIO driver. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Embed referenced DLLs into the exe (loaded by Program.ResolveEmbedded) so the output stays one file. -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>lib.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

</Project>
